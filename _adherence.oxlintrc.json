{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/calendar/**",
              "components/core/**",
              "ui_kits/calendar_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Serif SC|Noto Sans SC|Ma Shan Zheng))/i]",
        "message": "Font not provided by the design system. Available: Noto Serif SC, Noto Sans SC, Ma Shan Zheng."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlmanacItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|items|key|ref|className|style|children)$/]",
        "message": "<AlmanacItem> doesn't accept that prop. Declared props: kind, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlmanacItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:good|avoid)$/]",
        "message": "<AlmanacItem> kind must be one of 'good' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|gold|good|avoid|info|neutral)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'gold' | 'good' | 'avoid' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlessingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|label|seal|key|ref|className|style|children)$/]",
        "message": "<BlessingCard> doesn't accept that prop. Declared props: text, label, seal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|gold)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|tone|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|sunken|gold|brand)$/]",
        "message": "<Card> tone must be one of 'default' | 'sunken' | 'gold' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:solar|lunar|today|selected|rest|festival|otherMonth|onClick|key|ref|className|style|children)$/]",
        "message": "<DateCell> doesn't accept that prop. Declared props: solar, lunar, today, selected, rest, festival, otherMonth, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|disabled|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, label, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|soft|brand|outline)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'soft' | 'brand' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LunarDate'] > JSXAttribute > JSXIdentifier[name!=/^(?:lunarMonth|lunarDay|ganzhi|zodiac|align|key|ref|className|style|children)$/]",
        "message": "<LunarDate> doesn't accept that prop. Declared props: lunarMonth, lunarDay, ganzhi, zodiac, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='LunarDate'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<LunarDate> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SealStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:char|size|key|ref|className|style|children)$/]",
        "message": "<SealStamp> doesn't accept that prop. Declared props: char, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: selected, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
